# Copy this file to .env and fill in real values for local development.
# .env is gitignored - never commit real credentials.
# On FullHost, these same variable names are set via the app node's
# "Variables" panel (or auto-injected via node Links), not via a file.

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cbc_dev

# This is a multi-circle platform - the circle is always resolved from the request's
# Host header subdomain (vancouver.cbc.birdcount.ca, etc.), with no default/fallback
# circle. Raw localhost/127.0.0.1 has no subdomain to resolve, so local dev/testing
# uses a dedicated circle (slug 'test') reached via the IANA-reserved .test TLD
# (RFC 6761 - permanently reserved, can never resolve on the real internet, unlike a
# real-looking domain that might actually be owned by someone else):
#   1. Add to your hosts file (C:\Windows\System32\drivers\etc\hosts on Windows):
#        127.0.0.1 test.cbc.test
#   2. Browse to http://test.cbc.test:8080 instead of http://127.0.0.1:8080
# See app.py's CIRCLE_SUBDOMAIN_PATTERNS/resolve_circle().

# Email (SMTP2GO is the default provider - see config/email_settings.py).
# Without these set, the app boots fine but email sending silently no-ops.
SMTP2GO_USERNAME=
SMTP2GO_PASSWORD=

# Redirects ALL outgoing email (including magic-link logins) to TEST_RECIPIENT
# (config/organization.py) instead of the real recipient. is_test_server() also
# auto-detects this from a "test" substring in the request host (e.g. cbc-test.*),
# but localhost doesn't match that, so set this explicitly for local dev.
TEST_MODE=true

# The session cookie is Secure (HTTPS-only) by default - correct for FullHost/prod,
# but over plain http://localhost the browser will never send it back, so every
# form submit fails CSRF ("the session token is missing"). Uncomment for local dev:
# SESSION_COOKIE_SECURE=false
